{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "functions": {
    "api/index.ts": {
      "runtime": "nodejs20.x"
    },
    "api/tanstack-start.ts": {
      "runtime": "nodejs20.x"
    }

  }
}






